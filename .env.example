# Tenant-scoped storage root (sessions, cross-session memory)
# Layout: {NEXUS_DATA_ROOT}/{tenant_id}/users/{user_id}/...
NEXUS_DATA_ROOT=./tenants

# Global agent skills directory (agentskills.io SKILL.md folders)
# Layout: {NEXUS_SKILLS_ROOT}/{skill-name}/SKILL.md
NEXUS_SKILLS_ROOT=./skills

# PostgreSQL session + cross-session memory (production)
# NEXUS_PG_DSN=postgresql://user:pass@localhost:5432/nexus
# NEXUS_PG_SCHEMA=public
# NEXUS_PG_SCHEMA_MODE=managed
# NEXUS_PG_AUTO_MIGRATE=false

# Redis session + cross-session memory (cache / low-latency tier)
# NEXUS_REDIS_URL=redis://localhost:6379/0
# NEXUS_REDIS_TTL_SECONDS=86400

# Integration tests (docker-compose.test.yml maps 5433 / 6380)
# NEXUS_TEST_PG_DSN=postgresql://nexus:nexus@localhost:5433/nexus_test
# NEXUS_TEST_PG_SCHEMA=public
# NEXUS_TEST_REDIS_URL=redis://localhost:6380/0

# Platform API keys (used when no custom LLM endpoint is configured)
PLATFORM_OPENAI_KEY=sk-your-openai-key
PLATFORM_ANTHROPIC_KEY=sk-ant-your-anthropic-key

# Custom LLM endpoint: LiteLLM proxy, LM Studio, or any OpenAI-compatible server
# provider selects the adapter; base_url is an optional endpoint override (not a routing signal)
# When NEXUS_LLM_BASE_URL is set, the Nexus SaaS example routes through that endpoint.
NEXUS_LLM_PROVIDER=litellm
NEXUS_LLM_BASE_URL=http://localhost:4000
NEXUS_LLM_API_KEY=your-proxy-key
NEXUS_LLM_MODEL=openai/qwen

# Deprecated (still supported): use NEXUS_LLM_* above instead
# LM_STUDIO_BASE_URL=
# LM_STUDIO_API_KEY=
# LM_STUDIO_MODEL=openai/qwen

# ── Voice Lab (real end-to-end browser testing) ────────────────────────────────
# ./scripts/run_voice_lab.sh
# Or: uv run python -m nexus.server up -c examples/servers.yaml
#     uv run --extra fastapi --extra realtime --extra litellm --extra grpc \\
#       uvicorn examples.voice_lab:app --port 8787
# VOICE_LAB_PORT=8787
# NEXUS_VOICE_MANIFEST=examples/orchestration/voice_grpc.yaml
# NEXUS_SERVERS_CONFIG=examples/servers.yaml
# NEXUS_TENANT_ID=lab
# NEXUS_USER_ID=tester

# Media server engines (set mock for CPU-only quick test; conformer/parler for real)
# STT_ENGINE=conformer
# STT_DEVICE=cpu
# STT_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# STT_LANGUAGE=hi          # legacy alias for VOICE_DEFAULT_LANGUAGE
# VOICE_DEFAULT_LANGUAGE=en   # default reply/STT/LID language: en (worldwide) or hi
# TTS_ENGINE=parler
# TTS_DEVICE=cuda
# TTS_SAMPLE_RATE=44100
# TTS_VOICE=Divya speaks in a clear expressive voice at a moderate pace.
# VAD_ENGINE=silero
# VAD_PROVIDER=energy
# LID_ENGINE=faster_whisper

# LLM for voice agent (liteLLM — hosting is external)
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=
# VOICE_LLM_MODEL=ollama/qwen3:4b
# VOICE_LLM_MAX_TOKENS=150
# VOICE_SYSTEM_PROMPT=You are a helpful voice assistant...

# ── Nexus media model servers (gRPC) ─────────────────────────────────────────
# Start: uv run python -m nexus.server up -c examples/servers.yaml
# Health: uv run python -m nexus.server health -c examples/servers.yaml
# STT_PORT=50051
# TTS_PORT=50052
# VAD_PORT=50053
# LID_PORT=50054

# ── LLM via liteLLM (text + voice agents; hosting is external) ──────────────
# VOICE_LLM_MODEL=ollama/qwen3:4b
# TEXT_LLM_MODEL=openai/gpt-4o-mini
# STT/TTS default to "mock" (no keys needed) for local demos.
# NEXUS_STT_PROVIDER=deepgram
# NEXUS_STT_MODEL=nova-3
# NEXUS_TTS_PROVIDER=openai
# NEXUS_TTS_MODEL=tts-1
# NEXUS_TTS_VOICE=alloy
# DEEPGRAM_API_KEY=your-deepgram-key
# OPENAI_VISION_MODEL=gpt-4o

# ── Speech-to-speech (S2S, optional) ─────────────────────────────────────────
# Used by voice_s2s_local.yaml and realtime_s2s_ui.py
# NEXUS_S2S_PROVIDER=moshi      # Kyutai Moshi (English)
# NEXUS_S2S_PROVIDER=human-1    # Human-1 (Hindi)
# NEXUS_S2S_BASE_URL=ws://localhost:8998

# ── Messaging channels (optional) ────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
# WHATSAPP_TOKEN=your-meta-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_VERIFY_TOKEN=nexus-verify
